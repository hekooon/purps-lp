---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import notFound from '../assets/wrong-floor.jpg';
import DownloadModal from '../components/DownloadModal.astro';

// Not found: a tilted picture, then the title, a line of explanation and a
// way back home, all centred. Served for any missing page (and at /404).
---

<Layout title="Purps">
	<Header />
	<main>
		<section class="not-found">
			<Image
				class="picture"
				src={notFound}
				alt=""
				widths={[720, 1080, 1440]}
				sizes="540px"
				quality={80}
				loading="eager"
			/>
			<h1>Wrong floor.</h1>
			<p class="text-subtitle">This page doesn’t exist or may have been moved.</p>
			<a class="home" href="/">Go to Home</a>
		</section>
	</main>
	<DownloadModal />
</Layout>

<style>
	/* Fills the window below the 96px nav, with everything centred in the
	   window as a whole: the extra 96px at the bottom balances the nav */
	main {
		display: flex;
		flex-direction: column;
		justify-content: center;
		box-sizing: border-box;
		min-height: calc(100svh - 96px);
		padding: 40px 16px calc(96px + 40px);
	}

	.not-found {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: var(--layout-max-width);
		margin: 0 auto;
		text-align: center;
	}

	/* Already cropped to 4:3, tipped a little off straight. Drawn at 360px
	   but served as if 540px (sizes above): turning an image softens it, so
	   it gets 1.5 times the pixels to stay sharp. */
	.picture {
		display: block;
		width: min(360px, 100%);
		height: auto;
		margin-bottom: 64px;
		rotate: 4deg;
	}

	/* Set like the section titles */
	h1 {
		margin: 0;
		font: var(--text-title);
		letter-spacing: var(--text-title-letter-spacing);
	}

	p {
		margin: 8px 0 0;
		color: var(--color-text-secondary);
	}

	/* The primary pill, as the hero's Download */
	.home {
		display: flex;
		align-items: center;
		height: 64px;
		margin-top: 40px;
		padding: 0 40px;
		border-radius: 999px;
		background: var(--color-text-primary);
		color: var(--color-text-on-color);
		font: 700 17px / 24px var(--font-sans);
		text-decoration: none;
		white-space: nowrap;
	}

	.home:hover {
		background: var(--color-button-primary-hover);
	}
</style>
