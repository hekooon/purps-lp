---
import MoneyBall from './MoneyBall.astro';

// Closing download prompt: the app icon and a download button. On scroll
// the ball from the orbit above flies down into the icon (see Markets), and
// the icon's tile grows in to catch it; the icon's own ball is only for
// where that doesn't run.
---

<section class="download-cta">
	<div class="content">
		<div class="icon" role="img" aria-label="Purps app icon">
			<MoneyBall class="icon-ball" lit={0} width={240} data-ball-end />
		</div>
		<div class="cta">
			<a class="download" href="#" data-download>Download app</a>
			<p>Available on iOS and Android</p>
		</div>
	</div>
</section>

<style>
	.download-cta {
		position: relative;
		display: grid;
		place-items: center;
		padding: 40px 16px 160px;
		overflow: hidden;
		background: var(--color-surface-neutral-bg);
	}

	.content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 57px;
	}

	/* 120px app icon: the ball, unlit, on a dark tile */
	.icon {
		position: relative;
		display: grid;
		place-items: center;
		width: 120px;
		height: 120px;
		border: 1px solid var(--color-border-default);
		border-radius: 30px;
		background: #171616;
	}

	.icon :global(.icon-ball) {
		width: 72%;
	}

	/* Grows in from a tenth of its size over the second half of the ball's
	   flight, on the timeline and range Markets sets up. The ball itself
	   arrives from the orbit, so the tile's own stays hidden. */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.icon {
				animation: grow-in ease-out both;
				animation-timeline: --markets;
				animation-range: cover var(--icon-start, 0px) cover var(--icon-end, 0px);
			}

			.icon :global(.icon-ball) {
				visibility: hidden;
			}
		}
	}

	@keyframes grow-in {
		from {
			opacity: 0;
			scale: 0.1;
		}
	}

	.cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}

	.download {
		display: flex;
		align-items: center;
		height: 64px;
		padding: 0 40px;
		border-radius: 999px;
		background: var(--color-text-primary);
		color: var(--color-text-on-color);
		font: var(--text-heading);
		font-feature-settings: 'lnum' 1, 'tnum' 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.download:hover {
		background: var(--color-button-primary-hover);
	}

	p {
		margin: 0;
		color: var(--color-text-secondary);
		font: var(--text-body-1);
		font-feature-settings: 'lnum' 1, 'tnum' 1;
	}
</style>
