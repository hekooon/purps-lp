---
import { Image } from 'astro:assets';
import moneyBall from '../assets/money-ball.png';

// Closing download prompt: the app icon and a download button.
---

<section class="download-cta">
	<div class="content">
		<div class="icon">
			<Image src={moneyBall} alt="Purps app icon" width={300} />
		</div>
		<div class="cta">
			<a class="download" href="#" data-download>Download app</a>
			<p>Available on iOS and Android</p>
		</div>
	</div>
</section>

<style>
	.download-cta {
		position: relative;
		display: grid;
		place-items: center;
		padding: 40px 16px 160px;
		overflow: hidden;
		background: var(--color-surface-neutral-bg);
	}

	.content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 57px;
	}

	/* 120px app icon: the ball, zoomed in a little, on a dark tile */
	.icon {
		position: relative;
		width: 120px;
		height: 120px;
		overflow: hidden;
		border: 1px solid var(--color-border-default);
		border-radius: 30px;
		background: #171616;
	}

	.icon img {
		position: absolute;
		top: -9.5%;
		left: -9.2%;
		width: 126%;
		max-width: none;
		height: auto;
	}

	.cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}

	.download {
		display: flex;
		align-items: center;
		height: 64px;
		padding: 0 40px;
		border-radius: 999px;
		background: var(--color-text-primary);
		color: var(--color-text-on-color);
		font: var(--text-heading);
		font-feature-settings: 'lnum' 1, 'tnum' 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.download:hover {
		background: var(--color-button-primary-hover);
	}

	p {
		margin: 0;
		color: var(--color-text-secondary);
		font: var(--text-body-1);
		font-feature-settings: 'lnum' 1, 'tnum' 1;
	}
</style>
