---
import StatusBar from './StatusBar.astro';
import TouchCursor from './TouchCursor.astro';

interface Props {
	src: string;
	title: string;
}

const { src, title } = Astro.props;
---

<div class="prototype">
	<div class="device">
		<span class="button action" aria-hidden="true"></span>
		<span class="button volume-up" aria-hidden="true"></span>
		<span class="button volume-down" aria-hidden="true"></span>
		<span class="button side" aria-hidden="true"></span>
		<span class="button camera-control" aria-hidden="true"></span>

		<!-- Aluminium band (outer edge, polished face, inner lip), then the black bezel -->
		<span class="band-edge" data-squircle="73" aria-hidden="true"></span>
		<span class="band-face" data-squircle="72" aria-hidden="true"></span>
		<span class="band-lip" data-squircle="69" aria-hidden="true"></span>
		<span class="bezel" data-squircle="68" aria-hidden="true"></span>

		<div class="phone" data-squircle="60">
			<StatusBar />
			<iframe {src} {title} allow="clipboard-write; fullscreen"></iframe>
		</div>
	</div>
	<TouchCursor />
</div>

<style>
	.prototype {
		display: flex;
		justify-content: center;
		width: 100%;
	}

	/* iPhone 17: 402×874pt screen inside an 8px black bezel and a 5px
	   aluminium band. Every layer is clipped to a smoothed squircle whose
	   radius grows with its inset, so all the corners stay concentric. */
	.device {
		--band: 5px;
		--bezel: 8px;

		position: relative;
		flex: none;
		padding: calc(var(--band) + var(--bezel));
		filter: drop-shadow(0 32px 64px rgba(0, 0, 0, 0.5));
		/* Narrow screens scale the whole device down (see script) */
		transform-origin: top center;
	}

	.band-edge,
	.band-face,
	.band-lip,
	.bezel {
		position: absolute;
	}

	.band-edge {
		inset: 0;
		border-radius: 73px;
		background: linear-gradient(180deg, #2a2318, #15110b);
	}

	/* Brushed champagne gold: soft diagonal light bands plus a sheen on
	   the long edges */
	.band-face {
		inset: 1px;
		border-radius: 72px;
		background:
			linear-gradient(
				90deg,
				rgba(255, 236, 200, 0.16),
				transparent 6%,
				transparent 94%,
				rgba(255, 236, 200, 0.16)
			),
			linear-gradient(
				135deg,
				#a8916a 0%,
				#5c4e38 20%,
				#8c7756 38%,
				#4a3f2e 55%,
				#7c6a4d 74%,
				#54472f 88%,
				#9a8562 100%
			);
	}

	.band-lip {
		inset: calc(var(--band) - 1px);
		border-radius: 69px;
		background: #0d0b08;
	}

	.bezel {
		inset: var(--band);
		border-radius: 68px;
		background: #000;
	}

	.phone {
		position: relative;
		display: flex;
		flex-direction: column;
		width: 402px;
		height: 874px;
		max-height: calc(100vh - 74px);
		overflow: hidden;
		/* Plain rounded corners until the script swaps in the smoothed path */
		border-radius: 60px;
		background: var(--color-surface-neutral-bg);
	}

	iframe {
		flex: 1;
		width: 100%;
		border: 0;
		background: var(--color-surface-neutral-bg);
	}

	/* Side buttons sit under the band and stick out 3px. Positions follow the
	   iPhone 17: Action button and volume on the left, side button and
	   Camera Control on the right. */
	.button {
		position: absolute;
		width: 6px;
		border-radius: 2px;
		background: linear-gradient(90deg, #5a4c36, #a08a64 50%, #5a4c36);
	}

	.action,
	.volume-up,
	.volume-down {
		left: -3px;
	}

	.side,
	.camera-control {
		right: -3px;
	}

	.action {
		top: 18.5%;
		height: 3.6%;
	}

	.volume-up {
		top: 26.8%;
		height: 7%;
	}

	.volume-down {
		top: 35.5%;
		height: 7%;
	}

	.side {
		top: 29%;
		height: 11.3%;
	}

	/* Camera Control is a flush sapphire crystal, darker than the band */
	.camera-control {
		top: 63%;
		height: 5.7%;
		background: linear-gradient(90deg, #17140f, #2f2a22 50%, #17140f);
	}
</style>

<script>
	import { getSvgPath } from 'figma-squircle';

	// iOS continuous corners: Figma's corner smoothing at 60% matches them.
	// Each [data-squircle] element is clipped to a smoothed outline with the
	// corner radius given in the attribute, redrawn whenever it resizes.
	const CORNER_SMOOTHING = 0.6;

	for (const el of document.querySelectorAll<HTMLElement>('[data-squircle]')) {
		const cornerRadius = Number(el.dataset.squircle);
		new ResizeObserver(([entry]) => {
			const { inlineSize: width, blockSize: height } = entry.borderBoxSize[0];
			const path = getSvgPath({
				width,
				height,
				cornerRadius,
				cornerSmoothing: CORNER_SMOOTHING,
				preserveSmoothing: true,
			});
			el.style.clipPath = `path('${path}')`;
			el.style.borderRadius = '0';
		}).observe(el);
	}

	// The prototype is laid out for a full-width phone screen, so rather than
	// squeezing it, scale the whole device down when the page is narrower,
	// and pull up the space the unscaled height would leave below it.
	for (const container of document.querySelectorAll<HTMLElement>('.prototype')) {
		const device = container.querySelector<HTMLElement>('.device');
		if (!device) continue;
		new ResizeObserver(() => {
			const scale = Math.min(1, container.clientWidth / device.offsetWidth);
			device.style.transform = scale < 1 ? `scale(${scale})` : '';
			device.style.marginBottom = `${(scale - 1) * device.offsetHeight}px`;
		}).observe(container);
	}
</script>
