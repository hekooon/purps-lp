---
interface Props {
	src: string;
	title: string;
}

const { src, title } = Astro.props;
---

<div class="prototype">
	<iframe {src} {title} allow="clipboard-write; fullscreen"></iframe>
</div>

<style>
	.prototype {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 100vh;
		padding: 24px 16px;
	}

	iframe {
		width: 393px;
		max-width: 100%;
		height: 852px;
		max-height: calc(100vh - 48px);
		border: 0;
		border-radius: 48px;
		background: #000;
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
	}
</style>
