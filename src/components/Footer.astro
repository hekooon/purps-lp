---
// Site footer, all centred, carrying on from the centred download prompt
// above: the mailing list sign-up, one row of links, then the legal note,
// ending with the copyright, as fine print. Text in the Heading, Body 1,
// Body 2 and Label 1 styles. The links are placeholders until those pages
// exist.
const links = [
	{ name: 'X', href: '#' },
	{ name: 'TikTok', href: '#' },
	{ name: 'Instagram', href: '#' },
	{ name: 'Contact', href: '#' },
	{ name: 'Terms', href: '#' },
	{ name: 'Privacy', href: '#' },
];
---

<footer class="footer">
	<div class="inner">
		<div class="mailing">
			<h2 id="footer-newsletter" class="text-heading">Join the mailing list</h2>
			<form class="newsletter" aria-labelledby="footer-newsletter">
				<input
					class="text-body-1"
					type="email"
					name="email"
					placeholder="Enter your email"
					autocomplete="email"
					required
					aria-label="Email address"
				/>
				<button type="submit" aria-label="Subscribe">
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
						<path
							d="M4 12h16m-6-6 6 6-6 6"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</button>
			</form>
		</div>

		<nav aria-label="Footer">
			<ul class="links text-label-1">
				{
					links.map(({ name, href }) => (
						<li>
							<a {href}>{name}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<p class="legal text-body-2">
			Purps is a market analytics and social app. Trading functionality is not available in the
			United States, Canada or other restricted jurisdictions. See our <a href="#"
				>Terms of Service</a
			> for the full list. © Purps 2026
		</p>
	</div>
</footer>

<style>
	.footer {
		padding: 0 var(--page-gutter);
		background: var(--color-surface-neutral-bg);
	}

	.inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: var(--layout-max-width);
		margin: 0 auto;
		padding: 80px var(--layout-padding) 40px;
		text-align: center;
	}

	@media (max-width: 600px) {
		.inner {
			padding-top: 48px;
		}
	}

	.mailing {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		width: min(400px, 100%);
		margin-bottom: 48px;
	}

	h2 {
		margin: 0;
		color: var(--color-text-primary);
		font: var(--text-heading);
		letter-spacing: normal;
	}

	/* A pill with the arrow button at its end */
	.newsletter {
		display: flex;
		align-items: center;
		width: 100%;
		height: 48px;
		padding: 0 4px 0 20px;
		border-radius: 999px;
		background: var(--color-surface-neutral-container);
	}

	input {
		flex: 1;
		min-width: 0;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-text-primary);
		outline: none;
	}

	input::placeholder {
		color: var(--color-text-tertiary);
		font: var(--text-body-1);
	}

	/* The arrow stays tertiary until the address is valid, then turns
	   primary; only then does hovering it invert it */
	button {
		display: grid;
		flex: none;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: none;
		color: var(--color-text-tertiary);
		cursor: default;
		transition:
			color 150ms ease-out,
			background-color 150ms ease-out;
	}

	.newsletter:has(input:valid) button {
		color: var(--color-text-primary);
		cursor: pointer;
	}

	.newsletter:has(input:valid) button:hover {
		background: var(--color-text-primary);
		color: var(--color-surface-neutral-bg);
	}

	/* One row */
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 24px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links a {
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color 150ms ease-out;
	}

	.links a:hover {
		color: var(--color-text-primary);
	}

	/* The legal note, ending with the copyright, in the tertiary colour */
	.legal {
		max-width: 760px;
		margin: 24px 0 0;
		color: var(--color-text-tertiary);
	}

	.legal a {
		color: inherit;
		text-decoration: none;
	}

	.legal a:hover {
		color: var(--color-text-primary);
	}

	/* On phones the six links sit in two columns of three: the socials, then
	   the rest */
	@media (max-width: 600px) {
		.links {
			display: grid;
			grid-template-columns: repeat(2, auto);
			grid-template-rows: repeat(3, auto);
			grid-auto-flow: column;
			gap: 12px 64px;
		}
	}
</style>

<script>
	// No mailing list behind it yet: a valid address just gets a thank-you
	for (const form of document.querySelectorAll<HTMLFormElement>('.footer .newsletter')) {
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const input = form.querySelector('input');
			form.reset();
			if (input) input.placeholder = 'Thanks, you’re on the list';
		});
	}
</script>
