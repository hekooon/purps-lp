---
import { Image } from 'astro:assets';
import moneyBall from '../assets/money-ball.png';

// Closing download prompt: the app icon and a download button, over a
// huge blurred copy of the icon's money ball running off the bottom right.
---

<footer class="footer">
	<div class="backdrop" aria-hidden="true">
		<Image src={moneyBall} alt="" width={1600} />
	</div>

	<div class="content">
		<div class="icon">
			<Image src={moneyBall} alt="Purps app icon" width={300} />
		</div>
		<div class="cta">
			<a class="download" href="#">Download Purps</a>
			<p>Available on iOS and Android</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		display: grid;
		place-items: center;
		min-height: clamp(560px, 45vw, 775px);
		padding: 80px 16px;
		overflow: hidden;
		background: var(--color-surface-neutral-bg);
	}

	/* The ball at nearly twice the footer's width, so only its upper left
	   shows, blurred and dimmed with 40% of the background colour */
	.backdrop {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.backdrop img {
		position: absolute;
		top: 0;
		left: -4.5%;
		width: 193.5%;
		max-width: none;
		height: auto;
		translate: 0 -16.6%;
		filter: blur(12px);
	}

	.backdrop::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgb(17 16 16 / 0.4);
	}

	.content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 57px;
	}

	/* 120px app icon: the ball, zoomed in a little, on a dark tile */
	.icon {
		position: relative;
		width: 120px;
		height: 120px;
		overflow: hidden;
		border: 1px solid var(--color-border-default);
		border-radius: 30px;
		background: #171616;
	}

	.icon img {
		position: absolute;
		top: -9.5%;
		left: -9.2%;
		width: 126%;
		max-width: none;
		height: auto;
	}

	.cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}

	.download {
		display: flex;
		align-items: center;
		height: 64px;
		padding: 0 40px;
		border-radius: 999px;
		background: var(--color-text-primary);
		color: var(--color-text-on-color);
		font: 700 17px / 24px var(--font-sans);
		font-feature-settings: 'lnum' 1, 'tnum' 1;
		text-decoration: none;
		white-space: nowrap;
	}

	p {
		margin: 0;
		color: var(--color-text-primary);
		font: 500 14px / 20px var(--font-sans);
		font-feature-settings: 'lnum' 1, 'tnum' 1;
	}
</style>
