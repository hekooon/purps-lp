---
import { Image } from 'astro:assets';
import moneyBall from '../assets/money-ball.png';

// Closing download prompt: the app icon and a download button, with the name
// and legal links along the bottom.
---

<footer class="footer">
	<div class="content">
		<div class="icon">
			<Image src={moneyBall} alt="Purps app icon" width={300} />
		</div>
		<div class="cta">
			<a class="download" href="#" data-download>Download app</a>
			<p>Available on iOS and Android</p>
		</div>
	</div>

	<div class="bottom">
		<span>© Purps 2026</span>
		<nav class="links" aria-label="Legal">
			<a href="#">Contact</a>
			<a href="#">Terms</a>
			<a href="#">Privacy</a>
		</nav>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		display: grid;
		place-items: center;
		padding: 40px 16px 260px;
		overflow: hidden;
		background: var(--color-surface-neutral-bg);
	}

	/* Along the bottom, inset like the nav so it lines up with the logo there.
	   Set like the nav's Download button, but in the tertiary colour. */
	.bottom {
		position: absolute;
		right: 16px;
		bottom: 32px;
		left: 16px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 24px;
		max-width: var(--layout-max-width);
		margin: 0 auto;
		padding: 0 var(--layout-padding);
		color: var(--color-text-tertiary);
		font: 700 14px / 20px var(--font-sans);
		font-feature-settings: 'lnum' 1, 'tnum' 1;
		white-space: nowrap;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 24px;
	}

	.links a {
		color: inherit;
		text-decoration: none;
	}

	.content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 57px;
	}

	/* 120px app icon: the ball, zoomed in a little, on a dark tile */
	.icon {
		position: relative;
		width: 120px;
		height: 120px;
		overflow: hidden;
		border: 1px solid var(--color-border-default);
		border-radius: 30px;
		background: #171616;
	}

	.icon img {
		position: absolute;
		top: -9.5%;
		left: -9.2%;
		width: 126%;
		max-width: none;
		height: auto;
	}

	.cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}

	.download {
		display: flex;
		align-items: center;
		height: 64px;
		padding: 0 40px;
		border-radius: 999px;
		background: var(--color-text-primary);
		color: var(--color-text-on-color);
		font: 700 17px / 24px var(--font-sans);
		font-feature-settings: 'lnum' 1, 'tnum' 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.download:hover {
		background: var(--color-button-primary-hover);
	}

	p {
		margin: 0;
		color: var(--color-text-secondary);
		font: 500 14px / 20px var(--font-sans);
		font-feature-settings: 'lnum' 1, 'tnum' 1;
	}
</style>
