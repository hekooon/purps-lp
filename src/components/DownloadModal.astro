---
// As image files rather than inline, so their gradient and clip ids can't
// clash with anything else on the page
import appStore from '../assets/app-store.svg';
import googlePlay from '../assets/google-play.svg';
// Sample code from Wikimedia Commons until the real one is ready
import qrCode from '../assets/qr-code.svg';

// Download dialog: a QR code to scan with a phone, plus a pill button for each app
// store. Opens from any element marked [data-download]; closes from the
// × button, the backdrop or Escape. The QR code and store links are placeholders until the
// apps are live.
---

<dialog class="download-modal" aria-labelledby="download-modal-title">
	<button class="close" type="button" aria-label="Close">
		<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
			<path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
		</svg>
	</button>

	<h2 id="download-modal-title">Download the app</h2>

	<div class="qr-frame">
		<img class="qr" src={qrCode.src} alt="QR code to download Purps" width="200" height="200" />
	</div>

	<div class="stores">
		<a class="store" href="#">
			<img class="store-icon" src={appStore.src} alt="" width="24" height="24" />
			iOS
		</a>
		<a class="store" href="#">
			<img class="store-icon" src={googlePlay.src} alt="" width="24" height="24" />
			Android
		</a>
	</div>
</dialog>

<style>
	.download-modal {
		width: min(480px, calc(100vw - 32px));
		padding: 40px 32px 32px;
		border: 0;
		border-radius: 24px;
		background: var(--color-surface-neutral-bg);
		color: var(--color-text-primary);
		text-align: left;
	}

	.download-modal[open] {
		animation: modal-in 200ms cubic-bezier(0.2, 0, 0, 1);
	}

	.download-modal::backdrop {
		background: rgb(0 0 0 / 0.5);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.download-modal[open]::backdrop {
		animation: backdrop-in 200ms ease-out;
	}

	@keyframes modal-in {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.97);
		}
	}

	@keyframes backdrop-in {
		from {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.download-modal[open],
		.download-modal[open]::backdrop {
			animation: none;
		}
	}

	.close {
		position: absolute;
		top: 16px;
		right: 16px;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: none;
		color: var(--color-text-tertiary);
		cursor: pointer;
	}

	.close:hover {
		color: var(--color-text-primary);
	}

	h2 {
		margin: 0 0 32px;
		font-size: 32px;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	/* Full-width outlined panel with the code centred in it */
	.qr-frame {
		margin-bottom: 24px;
		padding: 64px 0;
		border: 0.5px solid var(--color-border-default);
		border-radius: 12px;
	}

	.qr {
		display: block;
		width: 200px;
		height: 200px;
		margin: 0 auto;
	}

	.stores {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}

	/* Pills: the store icon, then its name */
	.store {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		height: 64px;
		padding: 0 16px;
		border-radius: 999px;
		background: var(--color-surface-neutral-container);
		color: var(--color-text-primary);
		font: 700 17px / 24px var(--font-sans);
		text-decoration: none;
		white-space: nowrap;
	}

	.store:hover {
		background: var(--color-button-secondary-hover);
	}

	.store-icon {
		display: block;
		width: 24px;
		height: 24px;
	}

	/* Keep the page from scrolling behind the open dialog */
	:global(html:has(dialog.download-modal[open])) {
		overflow: hidden;
	}
</style>

<script>
	for (const modal of document.querySelectorAll<HTMLDialogElement>('.download-modal')) {
		for (const trigger of document.querySelectorAll<HTMLElement>('[data-download]')) {
			trigger.addEventListener('click', (event) => {
				event.preventDefault();
				modal.showModal();
			});
		}

		modal.querySelector('.close')?.addEventListener('click', () => modal.close());

		// A click on the backdrop lands on the dialog itself, outside its box
		modal.addEventListener('click', (event) => {
			const box = modal.getBoundingClientRect();
			const inside =
				event.clientX >= box.left &&
				event.clientX <= box.right &&
				event.clientY >= box.top &&
				event.clientY <= box.bottom;
			if (event.target === modal && !inside) modal.close();
		});
	}
</script>
