---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// The top traders as a row of portrait cards, #1 on the left: avatar, name,
// PnL and the markets they trade. Each PnL ticks every second, and as the
// ranking changes the cards slide past each other into the new order. It
// runs on past the right of the card, which crops it; there's nothing to
// click or drag. Six traders, all loaded up front (photos included), so one
// climbing into view never arrives half-drawn.
const avatars = import.meta.glob<{ default: ImageMetadata }>('../assets/leaderboard/*.jpg', {
	eager: true,
});
const avatar = (name: string) => avatars[`../assets/leaderboard/${name}.jpg`]?.default;
// Every market icon, the same set the markets section uses
const markets = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../assets/markets/*.png', { eager: true }),
).map((file) => file.default);

// A different handful of markets for each trader, MIN_ASSETS to MAX_ASSETS
// of them, picked at random each build
const MIN_ASSETS = 2;
const MAX_ASSETS = 7;
const pickAssets = () => {
	const count = MIN_ASSETS + Math.floor(Math.random() * (MAX_ASSETS - MIN_ASSETS + 1));
	return [...markets].sort(() => Math.random() - 0.5).slice(0, count);
};

const traders = [
	{ name: 'rugpulldaddy', pnl: 68_412.57 },
	{ name: '0xliquidated', pnl: 61_903.22 },
	{ name: 'apeintoit', pnl: 59_846.1 },
	{ name: 'wenlambo.eth', pnl: 52_377.84 },
	{ name: '100xorzero', pnl: 47_215.63 },
	{ name: 'ngmi_larry', pnl: 41_908.31 },
];

// Avatar size; each photo is loaded at twice it for sharp 2x screens. The
// photos in src/assets/leaderboard are already cropped to the Figma
// leaderboard's framing.
const AVATAR = 160;

// In thousands, to one decimal: +$68.4K
const usd = (n: number) => `+$${(n / 1000).toFixed(1)}K`;
---

<ol class="trader-cards" aria-hidden="true">
	{
		traders.map(({ name, pnl }, i) => (
			<li class="trader" style={`--slot: ${i}`} data-pnl={pnl} data-rank={i + 1}>
				<span class="rank">
					{i + 1}
				</span>
				<span class="avatar">
					<span class="photo">
						<Image
							src={avatar(`trader-${i + 1}`)!}
							alt=""
							width={AVATAR * 2}
							height={AVATAR * 2}
							loading="eager"
						/>
					</span>
				</span>
				<span class="name">{name}</span>
				<span class="pnl rolling">{usd(pnl)}</span>
				<span class="assets">
					{pickAssets().map((src) => (
						<Image class="asset" {src} alt="" width={64} height={64} loading="eager" />
					))}
				</span>
			</li>
		))
	}
</ol>

<style>
	/* Along the bottom of the card, inside its padding, in line with its
	   text on the left and running off its right edge */
	/* On phones the whole leaderboard is drawn smaller, so one and a half
	   cards show */
	@media (max-width: 600px) {
		.trader-cards {
			zoom: 0.78;
		}
	}

	.trader-cards {
		--card-width: 240px;
		--card-gap: 12px;
		/* Filling the space below the text (not just a line along its
		   bottom, which never counts as on screen for the script) */
		position: absolute;
		inset: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		font-feature-settings: 'lnum' 1, 'tnum' 1;
	}

	/* Every card sits at the left; --slot (its place in the ranking, set by
	   the script) moves it along, sliding when it changes. */
	.trader {
		position: absolute;
		bottom: 0;
		left: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: var(--card-width);
		padding: 40px;
		border-radius: 20px;
		/* Glass, as defined in global.css */
		background: var(--glass-background);
		backdrop-filter: var(--glass-blur);
		box-shadow: var(--glass-shadow);
		transform: translateX(calc(var(--slot) * (var(--card-width) + var(--card-gap))));
		transition: transform 1200ms ease-in-out;
	}

	/* The top three get their medal's colour (data-rank is kept up to date
	   by the script) for the rank number and a ring round the avatar; the
	   rest have quieter numbers and no ring */
	.trader {
		--medal: transparent;
		--rank-color: var(--color-text-tertiary);
	}

	.trader[data-rank='1'] {
		--medal: #e2b84f;
	}

	.trader[data-rank='2'] {
		--medal: #c6c6c4;
	}

	.trader[data-rank='3'] {
		--medal: #c58550;
	}

	.trader:is([data-rank='1'], [data-rank='2'], [data-rank='3']) {
		--rank-color: var(--medal);
	}

	/* While it slides to a new place: a card moving up swells to 1.05 and
	   passes over everything, one moving down shrinks to 0.95 and slips under,
	   each easing back to full size as it lands. The rest sit in between. */
	.trader {
		z-index: 1;
	}

	.trader.is-climbing {
		z-index: 2;
		animation: rank-up 1200ms ease-in-out;
	}

	.trader.is-falling {
		z-index: 0;
		animation: rank-down 1200ms ease-in-out;
	}

	@keyframes rank-up {
		50% {
			scale: 1.05;
		}
	}

	@keyframes rank-down {
		50% {
			scale: 0.95;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.trader.is-climbing,
		.trader.is-falling {
			animation: none;
		}
	}

	/* Its place in the ranking, in the top left corner */
	.rank {
		position: absolute;
		z-index: 1;
		top: 12px;
		left: 12px;
		display: grid;
		place-items: center;
		min-width: 24px;
		height: 24px;
		color: var(--rank-color);
		font: 700 13px / 1 var(--font-sans);
		transition: color 300ms ease-out;
	}

	/* The photo, as wide as the card inside its padding (so the same space
	   above it as either side) */
	.avatar {
		position: relative;
		flex: none;
		width: 100%;
		aspect-ratio: 1;
		margin-bottom: 24px;
	}

	.photo {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: 999px;
	}

	/* The medal ring: 4px wide, 4px out from the photo, with the card's glass
	   showing through the gap. A bordered circle rather than an offset
	   outline, which browsers round unevenly so the ring and gap don't come
	   out the same. */
	.avatar::after {
		content: '';
		position: absolute;
		inset: -8px;
		border: 4px solid var(--medal);
		border-radius: 999px;
		transition: border-color 300ms ease-out;
	}

	.photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.name {
		max-width: 100%;
		overflow: hidden;
		color: var(--color-text-primary);
		font: 700 15px / 20px var(--font-sans);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.pnl {
		display: inline-flex;
		align-items: baseline;
		margin: 0 0 24px;
		color: var(--color-text-positive);
		font: 700 32px / 40px var(--font-sans);
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.02em;
		white-space: pre;
	}

	/* The markets they trade, overlapping like the stacks in the hero title:
	   each overlaps the last by 22/48 of its size. Rather than a ring, each
	   one has a bite cut out where the next sits on it, a --gap wider than
	   that circle, so whatever's behind shows through between them. */
	.assets {
		--asset-size: 28px;
		--step: calc(var(--asset-size) * 26 / 48);
		--gap: calc(var(--asset-size) / 16);
		display: flex;
		align-items: center;
	}

	.asset {
		display: grid;
		flex: none;
		place-items: center;
		width: var(--asset-size);
		height: var(--asset-size);
		border-radius: 999px;
	}

	.asset + .asset {
		margin-left: calc(var(--asset-size) * -22 / 48);
	}

	.asset:not(:last-child) {
		--bite: calc(var(--asset-size) / 2 + var(--gap));
		mask-image: radial-gradient(
			circle at calc(50% + var(--step)) 50%,
			transparent var(--bite),
			#000 calc(var(--bite) + 0.5px)
		);
	}

	@media (prefers-reduced-motion: reduce) {
		.trader {
			transition: none;
		}
	}
</style>

<script>
	import { roll } from '../utils/roll';

	// Every TICK each PnL drifts a little, but never past a neighbour: the
	// order only changes every SHUFFLE ticks, when one trader climbs or falls
	// one to three places (half the time each, so the field doesn't bunch up
	// at the top), their PnL set to land between the two they now sit
	// between. Nobody goes over CAP, and neighbours are kept at
	// least GAP apart so their amounts never read the same.
	const TICK = 1000;
	const SHUFFLE = 3;
	const DRIFT = [-0.0025, 0.0025];
	const CAP = 70_000;
	const GAP = 400;

	const usd = (n: number) => `+$${(n / 1000).toFixed(1)}K`;

	const between = ([low, high]: number[]) => low + Math.random() * (high - low);

	for (const list of document.querySelectorAll<HTMLElement>('.trader-cards')) {
		const cards = [...list.querySelectorAll<HTMLElement>('.trader')].map((el, slot) => ({
			el,
			pnl: Number(el.dataset.pnl),
			slot,
			text: el.querySelector<HTMLElement>('.pnl')!,
			rank: el.querySelector<HTMLElement>('.rank')!,
		}));
		// Split each PnL into slots now, so its first change already rolls
		for (const card of cards) roll(card.text, usd(card.pnl));
		// Highest first
		const ranked = [...cards];
		let ticks = 0;

		const tick = () => {
			ticks++;
			for (const card of cards) card.pnl *= 1 + between(DRIFT);

			if (ticks % SHUFFLE === 0) {
				const places = 1 + Math.floor(Math.random() * 3);
				const last = ranked.length - 1;
				const climb = Math.random() < 0.5;
				// Climbers come from below the top, fallers from above the bottom
				const from = climb
					? 1 + Math.floor(Math.random() * last)
					: Math.floor(Math.random() * last);
				const to = climb ? Math.max(0, from - places) : Math.min(last, from + places);
				const [mover] = ranked.splice(from, 1);
				ranked.splice(to, 0, mover);
				const above = to > 0 ? ranked[to - 1].pnl : Math.min(CAP, ranked[1].pnl * 1.06);
				const below = to < last ? ranked[to + 1].pnl : above * 0.94;
				mover.pnl = between([below, above]);
			}

			// Keep the order as it stands: under the cap, each at least GAP
			// below the one above
			ranked.forEach((card, slot) => {
				const ceiling = slot === 0 ? CAP : ranked[slot - 1].pnl - GAP;
				card.pnl = Math.min(card.pnl, ceiling);
			});

			ranked.forEach((card, slot) => {
				if (slot !== card.slot) {
					// Restart the swell or shrink, even if it was mid-way
					card.el.classList.remove('is-climbing', 'is-falling');
					card.el.offsetWidth;
					card.el.classList.add(slot < card.slot ? 'is-climbing' : 'is-falling');
				}
				card.slot = slot;
				card.el.style.setProperty('--slot', String(slot));
				roll(card.text, usd(card.pnl));
				card.rank.textContent = String(slot + 1);
				card.el.dataset.rank = String(slot + 1);
			});
		};

		// Back to sitting level with the rest once the swell or shrink is over
		for (const card of cards) {
			card.el.addEventListener('animationend', () =>
				card.el.classList.remove('is-climbing', 'is-falling'),
			);
		}

		// Only while it's on screen
		let timer = 0;
		new IntersectionObserver(([entry]) => {
			clearInterval(timer);
			if (entry.isIntersecting) timer = window.setInterval(tick, TICK);
		}).observe(list);
	}
</script>
