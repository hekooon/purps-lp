---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Two huge rings sit behind the section, centred far above the element
// marked [data-floaters-centre] (the phone), so only their bottom arcs show:
// each dips from just under anything marked [data-floaters-avoid] at the
// window edges to low across the phone, one under the other. The inner ring
// carries the market icons in src/assets/markets/, the outer the trader
// portraits (the .jpgs) in src/assets/avatars/, all round and a fixed gap apart
// whatever the window size. The script slides them along the arcs in
// opposite directions; one that leaves at one edge comes back at the other
// as the next in its list, so every one comes round in turn. Place inside a
// positioned element; this fills it and sits behind it.
const glob = (files: Record<string, { default: ImageMetadata }>) =>
	Object.values(files).map((file) => file.default);
const coins = glob(import.meta.glob('../assets/markets/*.png', { eager: true }));
// Only the .jpg portraits: the folder also holds the title's .webp traders
const avatars = glob(import.meta.glob('../assets/avatars/*.jpg', { eager: true }));
---

<!-- The images for each ring; the script copies them into place -->
<div class="floaters" aria-hidden="true">
	{
		coins.map((src) => (
			<span class="ring-source" data-ring="0">
				<Image {src} alt="" width={320} height={320} loading="lazy" />
			</span>
		))
	}
	{
		avatars.map((src) => (
			<span class="ring-source" data-ring="1">
				<Image {src} alt="" width={320} height={320} loading="lazy" />
			</span>
		))
	}
</div>

<style>
	/* As wide as the window, whatever the width of the section it's in.
	   Fainter towards the middle: 90% at the window edges down to 20% across
	   the middle half. */
	.floaters {
		position: absolute;
		inset: 0;
		left: 50%;
		width: 100vw;
		translate: -50% 0;
		z-index: -1;
		pointer-events: none;
		mask-image: linear-gradient(
			90deg,
			rgb(0 0 0 / 0.9),
			rgb(0 0 0 / 0.2) 25%,
			rgb(0 0 0 / 0.2) 75%,
			rgb(0 0 0 / 0.9)
		);
	}

	@supports (animation-timeline: scroll()) {
		.floaters {
			animation-name: parallax;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: scroll(root);
			animation-range: 0 var(--parallax-range);
		}
	}

	/* Parallax: over the first --parallax-range of scrolling, the layer slides
	   down by --parallax-lag of that, so the images scroll by more slowly than
	   the text and phone in front of them. The script drives it instead where
	   scroll-driven animations aren't supported. */
	:root {
		--parallax-range: 1600px;
		--parallax-lag: 0.2;
	}

	@keyframes parallax {
		from {
			transform: none;
		}
		to {
			transform: translateY(calc(var(--parallax-range) * var(--parallax-lag)));
		}
	}

	.ring-source {
		display: none;
	}

	/* The rings' images, placed and moved by the script (so styled globally) */
	.floaters :global(.ring-image) {
		position: absolute;
		top: 0;
		left: 0;
		will-change: transform;
	}

	.floaters :global(.ring-image img) {
		display: block;
		width: 100%;
		height: auto;
		/* A bouncy spring: overshoots by about a quarter, bounces back once
		   and settles (sampled from a spring with damping ratio 0.4) */
		transition: scale 600ms
			linear(
				0,
				0.051,
				0.183,
				0.363,
				0.563,
				0.759,
				0.932,
				1.071,
				1.171,
				1.23,
				1.253,
				1.246,
				1.217,
				1.173,
				1.123,
				1.072,
				1.027,
				0.989,
				0.962,
				0.944,
				0.936,
				0.937,
				0.943,
				0.953,
				0.966,
				0.979,
				0.991,
				1.001,
				1.008,
				1.013,
				1
			);
	}

	/* The layer ignores the pointer, but its images can be hovered, shrinking
	   a little */
	.floaters :global(.ring-image) {
		pointer-events: auto;
	}

	.floaters :global(.ring-image:hover img) {
		scale: 0.95;
	}

	/* Icons and avatars alike are round */
	/* On a solid background, so transparent parts of an icon don't show the
	   images it overlaps */
	.floaters :global(.ring-image img) {
		border: 4px solid var(--color-surface-neutral-bg);
		border-radius: 999px;
		background: var(--color-surface-neutral-bg);
	}

	@media (prefers-reduced-motion: reduce) {
		.floaters {
			animation: none;
		}
	}
</style>

<script>
	// Space kept clear under the text
	const GAP = 24;

	// Sizes in px for a window FULL_WIDTH or wider, scaled down below it. The
	// inner ring is INNER times the window's width across; the outer one is
	// ROW_GAP further out. Icons are COIN wide, avatars AVATAR. Neighbours on
	// a ring always sit SPACE apart, edge to edge, whatever the window size
	// (not scaled). Images move at SPEED px a second.
	const FULL_WIDTH = 1280;
	const INNER = 1.8;
	const ROW_GAP = 200;
	const COIN = 136;
	const AVATAR = 136;
	const SPACE = 24;
	const SPEED = 15;
	// Images lean their tops in towards the ring's middle (across only), more
	// the further out they are: up to LEAN degrees at the window's edge, rising
	// faster towards the edges (by distance to the power LEAN_CURVE)
	const LEAN = 20;
	const LEAN_CURVE = 1.5;

	const scrollTimelines = CSS.supports('animation-timeline: scroll()');
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// The source images for ring 0 (inner) or 1 (outer)
	const sourcesFor = (layer: HTMLElement, ring: number) =>
		[...layer.querySelectorAll<HTMLImageElement>(`.ring-source[data-ring="${ring}"] img`)];

	// A copy of an image to show on a ring, loaded straight away
	const copyOf = (img: HTMLImageElement) => {
		const copy = img.cloneNode() as HTMLImageElement;
		copy.loading = 'eager';
		return copy;
	};

	type Track = {
		slots: { el: HTMLElement; s: number }[];
		items: HTMLImageElement[];
		next: number;
		radius: number;
		start: number; // angle where the track begins, off screen on the left
		length: number; // a whole number of steps, so the gap never changes
		step: number;
		speed: number;
	};

	for (const layer of document.querySelectorAll<HTMLElement>('.floaters')) {
		const section = layer.parentElement;
		if (!section) continue;
		const coins = sourcesFor(layer, 0);
		const avatars = sourcesFor(layer, 1);
		const avoid = [...section.querySelectorAll<HTMLElement>('[data-floaters-avoid]')];
		const centre = section.querySelector<HTMLElement>('[data-floaters-centre]');
		if (!centre || coins.length + avatars.length === 0) continue;

		// Without scroll-driven animations, follow the scroll here instead
		const fallback = !scrollTimelines && !reducedMotion;
		const parallax = () => {
			const style = getComputedStyle(layer);
			const range = parseFloat(style.getPropertyValue('--parallax-range'));
			const lag = parseFloat(style.getPropertyValue('--parallax-lag'));
			layer.style.transform = `translateY(${Math.min(window.scrollY, range) * lag}px)`;
		};
		if (fallback) {
			let frame = 0;
			window.addEventListener(
				'scroll',
				() => {
					cancelAnimationFrame(frame);
					frame = requestAnimationFrame(parallax);
				},
				{ passive: true },
			);
		}

		let tracks: Track[] = [];
		let cx = 0;
		let cy = 0;
		let halfWidth = 1;

		// Where a slot sits: `s` px along its track, in layer coordinates
		const place = (track: Track, slot: Track['slots'][number]) => {
			const angle = track.start + slot.s / track.radius;
			const x = cx + track.radius * Math.cos(angle);
			const y = cy + track.radius * Math.sin(angle);
			const out = Math.max(-1, Math.min(1, (x - cx) / halfWidth));
			const lean = -Math.sign(out) * Math.abs(out) ** LEAN_CURVE * LEAN;
			slot.el.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%) rotate(${lean}deg)`;
		};

		const build = () => {
			// Measure with the parallax shift taken off, so the rings line up
			// with the text the way they do before any scrolling
			layer.querySelectorAll('.ring-image').forEach((el) => el.remove());
			layer.style.animation = 'none';
			layer.style.transform = 'none';
			const bounds = layer.getBoundingClientRect();
			const phone = centre.getBoundingClientRect();
			const textBottom = Math.max(
				bounds.top,
				...avoid.map((el) => el.getBoundingClientRect().bottom + GAP),
			);
			layer.style.animation = '';
			layer.style.transform = '';
			if (fallback) parallax();

			// From the window, not the phone: the phone is scaled to fit by its
			// own script, which may not have run yet
			const scale = Math.min(1, window.innerWidth / FULL_WIDTH);
			halfWidth = bounds.width / 2;
			const coinSize = COIN * scale;
			const avatarSize = AVATAR * scale;
			const rowGap = ROW_GAP * scale;
			const inner = halfWidth * INNER;

			// Centred on the phone across, and far enough above that the inner
			// ring meets the window edges just under the text
			cx = (phone.left + phone.right) / 2 - bounds.left;
			cy = textBottom + coinSize / 2 - Math.sqrt(inner ** 2 - halfWidth ** 2) - bounds.top;

			const rings = [
				{ radius: inner, items: coins, width: coinSize },
				{ radius: inner + rowGap, items: avatars, width: avatarSize },
			].filter(({ items }) => items.length > 0);

			tracks = rings.map(({ radius, items, width }, row) => {
				// The track runs along the bottom of the circle from just past the
				// left edge of the window to just past the right, rounded up to a
				// whole number of steps
				const step = width + SPACE;
				const reach = halfWidth + width;
				const edge = radius > reach ? Math.acos(reach / radius) : 0;
				const visible = radius * (Math.PI - 2 * edge);
				const count = Math.ceil(visible / step) + 1;
				const length = count * step;
				const start = Math.PI / 2 - length / radius / 2;

				const slots = Array.from({ length: count }, (_, k) => {
					const el = document.createElement('span');
					el.className = 'ring-image';
					el.style.width = `${width}px`;
					el.append(copyOf(items[k % items.length]));
					layer.append(el);
					return { el, s: k * step };
				});
				const track: Track = {
					slots,
					items,
					next: count % items.length,
					radius,
					start,
					length,
					step,
					// The rings go opposite ways
					speed: row === 0 ? SPEED : -SPEED,
				};
				slots.forEach((slot) => place(track, slot));
				return track;
			});
			layer.classList.add('ringed');
		};

		// Slide everything along; a slot that runs off one end of its track
		// comes back on at the other, off screen, as the next image in the list
		let last = 0;
		const tick = (now: number) => {
			const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
			last = now;
			for (const track of tracks) {
				for (const slot of track.slots) {
					let s = slot.s + track.speed * dt;
					if (s >= track.length || s < 0) {
						s = (s + track.length) % track.length;
						const item = track.items[track.next];
						track.next = (track.next + 1) % track.items.length;
						slot.el.replaceChildren(copyOf(item));
					}
					slot.s = s;
					place(track, slot);
				}
			}
			requestAnimationFrame(tick);
		};

		// Rebuilt whenever the window or the phone change size. Not the text:
		// the title's intro changes its width as it plays, which would restart
		// the rings for nothing.
		let frame = 0;
		const schedule = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(build);
		};
		const observer = new ResizeObserver(schedule);
		for (const el of [layer, centre]) observer.observe(el);
		build();
		document.fonts.ready.then(build);
		if (!reducedMotion) requestAnimationFrame(tick);
	}
</script>
