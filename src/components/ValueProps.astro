---
// Value prop cards, one per row. Each sticks just under the nav as it
// reaches it, so the next one scrolls up and lands on top of it, while the
// one underneath shrinks and blurs away.
// Placeholder copy and images until the real ones are in.
const cards = [
	{
		title: 'Every market, live',
		subtitle: 'Placeholder: prices, funding and liquidity update the moment they move.',
	},
	{
		title: 'Follow the winners',
		subtitle: 'Placeholder: see what top traders are buying and copy them in a tap.',
	},
	{
		title: 'Trade in seconds',
		subtitle: 'Placeholder: pick a market, set your size and you’re in.',
	},
	{
		title: 'Cash out anytime',
		subtitle: 'Placeholder: move your winnings out whenever you want, 24/7.',
	},
];
---

<section class="value-props">
	{
		cards.map(({ title, subtitle }) => (
			<article class="card">
				<div class="copy">
					<h2>{title}</h2>
					<p class="text-subtitle">{subtitle}</p>
				</div>
				<div class="image" aria-hidden="true">Image</div>
			</article>
		))
	}
</section>

<style>
	.value-props {
		display: flex;
		flex-direction: column;
		gap: 24px;
		max-width: 1028px;
		margin: 160px auto 0;
	}

	/* Sticks 24px under the 80px nav. Cards later in the page paint over
	   earlier ones, so each lands on top of the last. */
	.card {
		position: sticky;
		top: 104px;
		display: flex;
		flex-direction: column;
		gap: 40px;
		height: min(680px, calc(100svh - 128px));
		padding: 48px;
		border: 0.5px solid var(--color-border-default);
		border-radius: 24px;
		background: var(--color-surface-neutral-bg);
		/* --covered runs 0 to 1 as the next card slides over this one (set by
		   the script); it shrinks back from its top edge throughout, and only
		   blurs out over the second half, up to 10px */
		transform-origin: top center;
		transform: scale(calc(1 - var(--covered, 0) * 0.1));
		filter: blur(calc(max(0, var(--covered, 0) - 0.5) * 20px));
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transform: none;
		}
	}

	h2 {
		margin: 0 0 12px;
		font-size: clamp(32px, 5vw, 48px);
		line-height: 1;
		letter-spacing: -0.02em;
	}

	p {
		max-width: 560px;
		margin: 0;
		color: var(--color-text-secondary);
	}

	.image {
		display: grid;
		flex: 1;
		place-items: center;
		min-height: 0;
		border-radius: 24px;
		background: var(--color-surface-neutral-container);
		color: var(--color-text-tertiary);
		font: 500 14px / 20px var(--font-sans);
	}

	@media (max-width: 600px) {
		.card {
			gap: 24px;
			padding: 24px;
		}
	}
</style>

<script>
	// How far each card's successor has travelled from the bottom of the
	// window to where it sticks: 0 before it shows, 1 once it covers this one
	for (const section of document.querySelectorAll<HTMLElement>('.value-props')) {
		const cards = [...section.querySelectorAll<HTMLElement>('.card')];

		const update = () => {
			cards.forEach((card, i) => {
				const next = cards[i + 1];
				if (!next) return;
				const stuckAt = parseFloat(getComputedStyle(next).top);
				const travelled = window.innerHeight - next.getBoundingClientRect().top;
				const covered = Math.min(1, Math.max(0, travelled / (window.innerHeight - stuckAt)));
				card.style.setProperty('--covered', covered.toFixed(3));
			});
		};

		let frame = 0;
		const schedule = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(update);
		};
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		update();
	}
</script>
