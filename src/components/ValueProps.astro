---
import { Image } from 'astro:assets';
import TraderCards from './TraderCards.astro';
import NotificationStack from './NotificationStack.astro';
import notificationsBackdrop from '../assets/cards/notifications.png';

// Value prop cards, one per row. Each sticks just under the nav as it
// reaches it, so the next one scrolls up and lands on top of it, while the
// one underneath shrinks and blurs away.
// Placeholder images until the real ones are in, bar the live visuals.
const cards = [
	{
		title: 'Discover most profitable traders',
		subtitle: 'Discover top traders. Follow the ones that are winning. No LARPing - just P&L.',
		visual: TraderCards,
	},
	{
		title: 'Real time notifications',
		subtitle: 'The second your traders open a position, you know. Don’t miss out on your next trade.',
		visual: NotificationStack,
		backdrop: notificationsBackdrop,
	},
	{
		title: 'Fund your account in seconds',
		subtitle: 'Add funds with card, Apple Pay, or crypto and start trading in seconds.',
	},
	{
		title: 'Go long, go short, go bigger',
		subtitle: 'Up or down, there’s always a trade. Trade with leverage across global markets.',
	},
];
---

<section class="value-props">
	{
		cards.map(({ title, subtitle, visual: Visual, backdrop }) => (
			<article class="card">
				<div class="copy">
					<h2>{title}</h2>
					<p class="text-subtitle">{subtitle}</p>
				</div>
				{Visual ? (
					<div class="image is-live">
						{backdrop && (
							<div class="backdrop">
								<Image src={backdrop} alt="" />
							</div>
						)}
						<Visual />
					</div>
				) : (
					<div class="image" aria-hidden="true">
						Image
					</div>
				)}
			</article>
		))
	}
</section>

<style>
	.value-props {
		display: flex;
		flex-direction: column;
		gap: 24px;
		max-width: var(--layout-max-width);
		margin: 160px auto 0;
	}

	/* Sticks 24px under the 96px nav. Cards later in the page paint over
	   earlier ones, so each lands on top of the last. */
	.card {
		position: sticky;
		top: 120px;
		display: flex;
		flex-direction: column;
		gap: 40px;
		height: min(680px, calc(100svh - 144px));
		padding: var(--layout-padding);
		border: 0.5px solid var(--color-border-default);
		border-radius: 24px;
		overflow: hidden;
		background: var(--color-surface-neutral-bg);
		/* --covered runs 0 to 1 as the next card slides over this one (set by
		   the script); it shrinks back from its top edge throughout, and only
		   blurs out over the second half, up to 10px */
		transform-origin: top center;
		transform: scale(calc(1 - var(--covered, 0) * 0.1));
		filter: blur(calc(max(0, var(--covered, 0) - 0.5) * 20px));
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transform: none;
		}
	}

	h2 {
		margin: 0 0 12px;
		font-size: clamp(28px, 4vw, 40px);
		line-height: 1;
		letter-spacing: -0.02em;
	}

	p {
		max-width: 560px;
		margin: 0;
		color: var(--color-text-secondary);
	}

	.image {
		display: grid;
		flex: 1;
		place-items: center;
		min-height: 0;
		border-radius: 24px;
		background: var(--color-surface-neutral-container);
		color: var(--color-text-tertiary);
		font: 500 14px / 20px var(--font-sans);
	}

	/* A live visual instead of the placeholder: it sizes itself to this box,
	   and may run on past it to be cropped by the card's own edge */
	.image.is-live {
		position: relative;
		display: block;
		container-type: inline-size;
		background: none;
	}

	/* A photo behind the live visual, from just below the text to the card's
	   left, right and bottom edges (out through the card's padding), filling
	   that whatever its shape, anchored to its top and fading in from there */
	.backdrop {
		--parallax: 120px;
		position: absolute;
		top: 0;
		left: calc(-1 * var(--layout-padding));
		width: calc(100% + 2 * var(--layout-padding));
		height: calc(100% + var(--layout-padding));
		overflow: hidden;
		/* Fades in over its whole height, eased so there's no hard edge
		   where it reaches full strength */
		mask-image: linear-gradient(
			to bottom,
			transparent,
			rgb(0 0 0 / 0.15) 20%,
			rgb(0 0 0 / 0.4) 40%,
			rgb(0 0 0 / 0.7) 65%,
			#000 100%
		);
		pointer-events: none;
	}

	/* A 25% black scrim over the photo, under the visual */
	.backdrop::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgb(0 0 0 / 0.25);
	}

	/* Parallax: --parallax taller than its frame, and lifted by that much
	   while the card is down the window, settling as the card rises to where
	   it sticks (--arrived, 0 to 1, set by the script). So it drifts down
	   inside the card as the card comes up, as if further away. */
	.backdrop :global(img) {
		display: block;
		width: 100%;
		max-width: none;
		height: calc(100% + var(--parallax));
		object-fit: cover;
		object-position: center top;
		translate: 0 calc(var(--parallax) * (var(--arrived, 1) - 1));
	}

	@media (prefers-reduced-motion: reduce) {
		.backdrop :global(img) {
			translate: none;
		}
	}

	@media (max-width: 600px) {
		.card {
			gap: 24px;
		}
	}
</style>

<script>
	// How far each card has travelled from the bottom of the window to where
	// it sticks: 0 before it shows, 1 once it's there. That's its --arrived
	// (for the photo's parallax), and its predecessor's --covered.
	for (const section of document.querySelectorAll<HTMLElement>('.value-props')) {
		const cards = [...section.querySelectorAll<HTMLElement>('.card')];

		const update = () => {
			const arrived = cards.map((card) => {
				const stuckAt = parseFloat(getComputedStyle(card).top);
				const travelled = window.innerHeight - card.getBoundingClientRect().top;
				return Math.min(1, Math.max(0, travelled / (window.innerHeight - stuckAt)));
			});
			cards.forEach((card, i) => {
				card.style.setProperty('--arrived', arrived[i].toFixed(3));
				if (i + 1 < cards.length) card.style.setProperty('--covered', arrived[i + 1].toFixed(3));
			});
		};

		let frame = 0;
		const schedule = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(update);
		};
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		update();
	}
</script>
