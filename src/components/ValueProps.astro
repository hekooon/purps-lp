---
import { Image } from 'astro:assets';
import TraderCards from './TraderCards.astro';
import NotificationStack from './NotificationStack.astro';
import FundingSheet from './FundingSheet.astro';
import LeverageSlider from './LeverageSlider.astro';
import card1Photo from '../assets/cards/card-1.jpg';
import card2Photo from '../assets/cards/card-2.jpg';
import card3Photo from '../assets/cards/card-3.jpg';
import card4Photo from '../assets/cards/card-4.jpg';

// Value prop cards, one per row. Each sticks just under the nav as it
// reaches it, so the next one scrolls up and lands on top of it, while the
// one underneath shrinks and blurs away.
// Every card has a photo of its own across its bottom three quarters.
const cards = [
	{
		title: 'Discover most profitable traders',
		subtitle: 'Discover top traders. Follow the ones that are winning. No LARPing - just P&L.',
		visual: TraderCards,
		photo: card1Photo,
	},
	{
		title: 'Real time notifications',
		subtitle: 'The second your traders open a position, you know. Don’t miss out on your next trade.',
		visual: NotificationStack,
		photo: card2Photo,
	},
	{
		title: 'Fund your account in seconds',
		subtitle: 'Add funds with card, Apple Pay, or crypto and start trading in seconds.',
		visual: FundingSheet,
		photo: card3Photo,
		// Its visual stands on the card's bottom edge (see the phone styles)
		short: true,
	},
	{
		title: 'Go long, go short, go bigger',
		subtitle: 'Up or down, there’s always a trade. Trade with leverage across global markets.',
		visual: LeverageSlider,
		photo: card4Photo,
	},
];
---

<section class="value-props">
	<h2 class="title">Read the market<br />like it’s your group chat</h2>
	{
		cards.map(({ title, subtitle, visual: Visual, photo, short }) => (
			<article class:list={['card', { short }]}>
				<div class="backdrop">
					<Image src={photo} alt="" widths={[800, 1200, 1600, 2000]} sizes="(max-width: 1120px) 100vw, 1120px" quality={65} />
				</div>
				<div class="copy">
					<h3>{title}</h3>
					<p>{subtitle}</p>
				</div>
				{Visual ? (
					<div class="image is-live">
						<Visual />
					</div>
				) : (
					<div class="image" aria-hidden="true">
						Placeholder image, in progress…
					</div>
				)}
			</article>
		))
	}
</section>

<style>
	/* 96px between the cards, less under the title */
	.value-props {
		display: flex;
		flex-direction: column;
		gap: 96px;
		max-width: var(--layout-max-width);
		margin: 240px auto 0;
	}

	/* Sticks 24px under the 96px nav. Cards later in the page paint over
	   earlier ones, so each lands on top of the last. */
	.card {
		position: sticky;
		top: 120px;
		display: flex;
		flex-direction: column;
		/* The extra room goes between the text and the visual */
		gap: 80px;
		height: min(720px, calc(100svh - 144px));
		/* Less the border, so the text lines up with the nav's logo */
		padding: calc(var(--layout-padding) - 0.5px);
		border: 0.5px solid var(--color-border-default);
		border-radius: 24px;
		overflow: hidden;
		background: var(--color-surface-neutral-bg);
		/* --covered runs 0 to 1 as the next card slides over this one (set by
		   the script); it shrinks back from its top edge throughout, and only
		   blurs out over the second half, up to 10px */
		transform-origin: top center;
		transform: scale(calc(1 - var(--covered, 0) * 0.1));
		filter: blur(calc(max(0, var(--covered, 0) - 0.5) * 20px));
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transform: none;
		}
	}

	/* Above the photo, where a card has one */
	.copy {
		position: relative;
	}

	/* The section's title, over the cards, inset like their copy so it
	   lines up with their titles */
	.title {
		max-width: 880px;
		margin: 0;
		padding: 0 var(--layout-padding);
		font: var(--text-title);
		letter-spacing: var(--text-title-letter-spacing);
		/* Takes back part of the 96px gap, leaving 48 */
		margin-bottom: -48px;
	}

	/* Title and subtitle read as one block: both set like the hero's
	   subheading (the subtitle style, a step up), with no gap between, the
	   title bold in the primary colour and the subtitle medium in the
	   tertiary */
	h3,
	.copy p {
		margin: 0;
		font: var(--text-subtitle);
		font-size: clamp(17px, 4.1vw, 24px);
		font-weight: 700;
	}

	.copy p {
		max-width: 560px;
		color: var(--color-text-tertiary);
		font-weight: 500;
	}

	.image {
		position: relative;
		display: grid;
		flex: 1;
		place-items: center;
		min-height: 0;
		border-radius: 24px;
		background: var(--color-surface-neutral-container);
		color: var(--color-text-tertiary);
		font: 500 14px / 20px var(--font-sans);
	}

	/* A live visual instead of the placeholder: it sizes itself to this box,
	   and may run on past it to be cropped by the card's own edge */
	.image.is-live {
		position: relative;
		display: block;
		container-type: inline-size;
		background: none;
	}

	/* The photo across the bottom three quarters of the card, edge to edge,
	   behind the text and visual, filling that whatever its shape, centred.
	   Served at quality 65: under the fade, the scrim and the glass, more
	   doesn't show. */
	.backdrop {
		--parallax: 120px;
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 75%;
		overflow: hidden;
		pointer-events: none;
	}

	/* Over the photo, under the text and visual: a fade along its top, from
	   the card's background colour to clear over 30% of the card's height
	   (30/75 of the photo's), and a 25% black scrim over it all */
	.backdrop::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to bottom, var(--color-surface-neutral-bg), transparent calc(30% / 0.75)),
			rgb(0 0 0 / 0.25);
	}

	/* Parallax: --parallax taller than its frame, and lifted by up to that
	   much while the card is down the window, settling as the card rises to
	   where it sticks. So it drifts down inside the card as the card comes
	   up, as if further away. The script sets the lift (--shift) in whole
	   pixels: the glass panels on top blur the photo, and a photo moving by
	   fractions of a pixel under them every frame made their blur shimmer.
	   It's kept on its own layer for the same reason. */
	.backdrop :global(img) {
		display: block;
		width: 100%;
		max-width: none;
		height: calc(100% + var(--parallax));
		object-fit: cover;
		object-position: center;
		translate: 0 var(--shift, 0);
		will-change: translate;
	}

	@media (prefers-reduced-motion: reduce) {
		.backdrop :global(img) {
			translate: none;
		}
	}

	/* On phones: a plain list of cards, edge to edge across the screen and
	   flush against each other, divided by a line along each one's top. No
	   sticking or stacking, corners or clipping. All the same height, the
	   first card's: 40px in from top and bottom (24px at the sides), the
	   text, then the visual in what's left. The last has a line along its
	   bottom too. */
	@media (max-width: 600px) {
		.value-props {
			gap: 0;
			margin-top: 96px;
		}

		.title {
			margin-bottom: 24px;
			padding: 0;
		}

		.card {
			position: relative;
			top: auto;
			margin: 0 calc(-1 * var(--page-gutter));
			padding: 40px var(--layout-padding);
			border: 0;
			border-top: 0.5px solid var(--color-border-default);
			border-radius: 0;
			overflow: visible;
			gap: 32px;
			height: 520px;
			transform: none;
			filter: none;
		}

		.card:last-child {
			border-bottom: 0.5px solid var(--color-border-default);
		}

		.image {
			flex: 1;
			height: auto;
		}

		/* The add-money sheet still stands on the card's bottom edge */
		.card.short .image :global(.sheet) {
			bottom: -40px;
		}
	}
</style>

<script>
	// --shift: how far the photo is lifted for the parallax, from the full
	// --parallax while the card is at the bottom of the window to nothing once
	// it's reached where it sticks, rounded to whole pixels. --covered: how
	// far the next card has slid over this one, 0 until it reaches this
	// card's bottom edge, 1 once it covers it.
	// So a card only starts shrinking away once the next actually overlaps
	// it, not as soon as the next comes into view.
	for (const section of document.querySelectorAll<HTMLElement>('.value-props')) {
		const cards = [...section.querySelectorAll<HTMLElement>('.card')];

		const update = () => {
			cards.forEach((card, i) => {
				const stuckAt = parseFloat(getComputedStyle(card).top);
				const top = card.getBoundingClientRect().top;
				const arrived = Math.min(
					1,
					Math.max(0, (window.innerHeight - top) / (window.innerHeight - stuckAt)),
				);
				const backdrop = card.querySelector<HTMLElement>('.backdrop');
				if (backdrop) {
					const range = parseFloat(getComputedStyle(backdrop).getPropertyValue('--parallax'));
					card.style.setProperty('--shift', `${Math.round(range * (arrived - 1))}px`);
				}

				const next = cards[i + 1];
				if (!next) return;
				// It shrinks from its top edge, so that stays put
				const bottom = top + card.offsetHeight;
				const nextStuckAt = parseFloat(getComputedStyle(next).top);
				const overlap = bottom - next.getBoundingClientRect().top;
				const covered = Math.min(1, Math.max(0, overlap / (bottom - nextStuckAt)));
				card.style.setProperty('--covered', covered.toFixed(3));
			});
		};

		let frame = 0;
		const schedule = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(update);
		};
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		update();
	}
</script>
