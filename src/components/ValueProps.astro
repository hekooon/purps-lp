---
import { Image } from 'astro:assets';
import TraderCards from './TraderCards.astro';
import NotificationStack from './NotificationStack.astro';
import FundingSheet from './FundingSheet.astro';
import officePhoto from '../assets/cards/office.png';
import wallStreetPhoto from '../assets/cards/wall-street.jpg';

// Value prop cards, one per row. Each sticks just under the nav as it
// reaches it, so the next one scrolls up and lands on top of it, while the
// one underneath shrinks and blurs away.
// Placeholder images until the real ones are in, bar the live visuals. Every
// card has a photo across its bottom half, the Wall Street desk or the
// office, alternating.
const cards = [
	{
		title: 'Discover most profitable traders',
		subtitle: 'Discover top traders. Follow the ones that are winning. No LARPing - just P&L.',
		visual: TraderCards,
		photo: wallStreetPhoto,
	},
	{
		title: 'Real time notifications',
		subtitle: 'The second your traders open a position, you know. Don’t miss out on your next trade.',
		visual: NotificationStack,
		photo: officePhoto,
	},
	{
		title: 'Fund your account in seconds',
		subtitle: 'Add funds with card, Apple Pay, or crypto and start trading in seconds.',
		visual: FundingSheet,
		photo: wallStreetPhoto,
	},
	{
		title: 'Go long, go short, go bigger',
		subtitle: 'Up or down, there’s always a trade. Trade with leverage across global markets.',
		photo: officePhoto,
	},
];
---

<section class="value-props">
	{
		cards.map(({ title, subtitle, visual: Visual, photo }) => (
			<article class="card">
				<div class="backdrop">
					<Image src={photo} alt="" widths={[800, 1200, 1600, 2240]} sizes="(max-width: 1120px) 100vw, 1120px" />
				</div>
				<div class="copy">
					<h2>{title}</h2>
					<p class="text-subtitle">{subtitle}</p>
				</div>
				{Visual ? (
					<div class="image is-live">
						<Visual />
					</div>
				) : (
					<div class="image" aria-hidden="true">
						Placeholder image, in progress…
					</div>
				)}
			</article>
		))
	}
</section>

<style>
	.value-props {
		display: flex;
		flex-direction: column;
		gap: 96px;
		max-width: var(--layout-max-width);
		margin: 160px auto 0;
	}

	/* Sticks 24px under the 96px nav. Cards later in the page paint over
	   earlier ones, so each lands on top of the last. */
	.card {
		position: sticky;
		top: 120px;
		display: flex;
		flex-direction: column;
		/* The extra room goes between the text and the visual */
		gap: 80px;
		height: min(720px, calc(100svh - 144px));
		/* Less the border, so the text lines up with the nav's logo */
		padding: calc(var(--layout-padding) - 0.5px);
		border: 0.5px solid var(--color-border-default);
		border-radius: 24px;
		overflow: hidden;
		background: var(--color-surface-neutral-bg);
		/* --covered runs 0 to 1 as the next card slides over this one (set by
		   the script); it shrinks back from its top edge throughout, and only
		   blurs out over the second half, up to 10px */
		transform-origin: top center;
		transform: scale(calc(1 - var(--covered, 0) * 0.1));
		filter: blur(calc(max(0, var(--covered, 0) - 0.5) * 20px));
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transform: none;
		}
	}

	/* Above the photo, where a card has one */
	.copy {
		position: relative;
	}

	h2 {
		margin: 0 0 12px;
		font-size: clamp(28px, 4vw, 40px);
		line-height: 1;
		letter-spacing: -0.02em;
	}

	p {
		max-width: 560px;
		margin: 0;
		color: var(--color-text-secondary);
	}

	.image {
		position: relative;
		display: grid;
		flex: 1;
		place-items: center;
		min-height: 0;
		border-radius: 24px;
		background: var(--color-surface-neutral-container);
		color: var(--color-text-tertiary);
		font: 500 14px / 20px var(--font-sans);
	}

	/* A live visual instead of the placeholder: it sizes itself to this box,
	   and may run on past it to be cropped by the card's own edge */
	.image.is-live {
		position: relative;
		display: block;
		container-type: inline-size;
		background: none;
	}

	/* The photo across the bottom half of the card, edge to edge, behind
	   the text and visual, filling that whatever its shape, anchored to its
	   top right like the Figma crop and fading in from the top */
	.backdrop {
		--parallax: 120px;
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 50%;
		overflow: hidden;
		/* Fades in over its whole height, eased so there's no hard edge
		   where it reaches full strength */
		mask-image: linear-gradient(
			to bottom,
			transparent,
			rgb(0 0 0 / 0.15) 20%,
			rgb(0 0 0 / 0.4) 40%,
			rgb(0 0 0 / 0.7) 65%,
			#000 100%
		);
		pointer-events: none;
	}

	/* A 25% black scrim over the photo, under the text and visual */
	.backdrop::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgb(0 0 0 / 0.25);
	}

	/* Parallax: --parallax taller than its frame, and lifted by up to that
	   much while the card is down the window, settling as the card rises to
	   where it sticks. So it drifts down inside the card as the card comes
	   up, as if further away. The script sets the lift (--shift) in whole
	   pixels: the glass panels on top blur the photo, and a photo moving by
	   fractions of a pixel under them every frame made their blur shimmer.
	   It's kept on its own layer for the same reason. */
	.backdrop :global(img) {
		display: block;
		width: 100%;
		max-width: none;
		height: calc(100% + var(--parallax));
		object-fit: cover;
		object-position: right top;
		translate: 0 var(--shift, 0);
		will-change: translate;
	}

	@media (prefers-reduced-motion: reduce) {
		.backdrop :global(img) {
			translate: none;
		}
	}

	@media (max-width: 600px) {
		.card {
			gap: 24px;
		}
	}
</style>

<script>
	// --shift: how far the photo is lifted for the parallax, from the full
	// --parallax while the card is at the bottom of the window to nothing once
	// it's reached where it sticks, rounded to whole pixels. --covered: how
	// far the next card has slid over this one, 0 until it reaches this
	// card's bottom edge, 1 once it covers it.
	// So a card only starts shrinking away once the next actually overlaps
	// it, not as soon as the next comes into view.
	for (const section of document.querySelectorAll<HTMLElement>('.value-props')) {
		const cards = [...section.querySelectorAll<HTMLElement>('.card')];

		const update = () => {
			cards.forEach((card, i) => {
				const stuckAt = parseFloat(getComputedStyle(card).top);
				const top = card.getBoundingClientRect().top;
				const arrived = Math.min(
					1,
					Math.max(0, (window.innerHeight - top) / (window.innerHeight - stuckAt)),
				);
				const backdrop = card.querySelector<HTMLElement>('.backdrop');
				if (backdrop) {
					const range = parseFloat(getComputedStyle(backdrop).getPropertyValue('--parallax'));
					card.style.setProperty('--shift', `${Math.round(range * (arrived - 1))}px`);
				}

				const next = cards[i + 1];
				if (!next) return;
				// It shrinks from its top edge, so that stays put
				const bottom = top + card.offsetHeight;
				const nextStuckAt = parseFloat(getComputedStyle(next).top);
				const overlap = bottom - next.getBoundingClientRect().top;
				const covered = Math.min(1, Math.max(0, overlap / (bottom - nextStuckAt)));
				card.style.setProperty('--covered', covered.toFixed(3));
			});
		};

		let frame = 0;
		const schedule = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(update);
		};
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		update();
	}
</script>
