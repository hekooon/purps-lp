---
import '../styles/global.css';

interface Props {
	title: string;
	// What link previews and search results show under the title
	description?: string;
}

const { title, description } = Astro.props;
// Link previews need the image's full address, not just its path
const previewImage = new URL('/og-image.jpg', Astro.site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<!-- Link previews when the page is shared -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Purps" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={previewImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="The Purps money ball, ringed by the markets you can trade" />
		<meta name="twitter:card" content="summary_large_image" />
		<!-- Favicon: the Purps mark (from Figma), dark for light browser themes
		     and light for dark ones. The SVG switches by itself; a PNG per theme
		     for browsers without SVG favicons; the .ico (dark mark) for those,
		     Safari among them, that look for /favicon.ico first; and for iOS
		     home screens, the light mark on a dark square. -->
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link
			rel="icon"
			href="/favicon-32-light.png"
			type="image/png"
			sizes="32x32"
			media="(prefers-color-scheme: light)"
		/>
		<link
			rel="icon"
			href="/favicon-32-dark.png"
			type="image/png"
			sizes="32x32"
			media="(prefers-color-scheme: dark)"
		/>
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<!-- The three font files the page uses, fetched straight away: the intro
		     waits for them before it plays -->
		<link rel="preload" href="/fonts/Satoshi-Medium.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Satoshi-Bold.woff2" as="font" type="font/woff2" crossorigin />
		<link
			rel="preload"
			href="/fonts/LibreCaslonCondensed-Bold.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<!-- Hold the title's intro until its font has loaded (or a second has
		     passed), so it doesn't start while the page is still busy or
		     swap fonts halfway through. Without JavaScript nothing waits. -->
		<script is:inline>
			const root = document.documentElement;
			root.classList.add('intro-wait');
			const start = () => requestAnimationFrame(() => root.classList.remove('intro-wait'));
			document.fonts.ready.then(start);
			setTimeout(start, 1000);
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
